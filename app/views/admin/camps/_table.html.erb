<%# locals: camps: %>
<table class="table table-striped" id="<%= local_assigns.fetch(:table_id, 'camps-table') %>">
  <thead>
    <tr>
      <th>Name</th>
      <th title="Events created this year (event_times in parens when different)">Events <small class="text-muted">(<%= LakesOfFireConfig.year %>)</small></th>
      <th>Site ID</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% camps.each do |camp| %>
      <% this_year_events = camp.events.select(&:in_configured_year?) %>
      <% this_year_event_count = this_year_events.size %>
      <% this_year_event_time_count = this_year_events.sum { |event| event.event_times.size } %>
      <tr id="camp_<%= camp.id %>">
        <td>
          <div class="camp-info">
            <h6 class="mb-1"><%= link_to camp.name, admin_camp_path(camp) %></h6>
            <% if camp.description.present? %>
              <p class="mb-0 text-muted small"><%= camp.description %></p>
            <% end %>
          </div>
        </td>
        <td>
          <%= this_year_event_count %>
          <% if this_year_event_time_count != this_year_event_count %>
            (<%= this_year_event_time_count %>)
          <% end %>
        </td>
        <td>
          <% if camp.location.present? && (camp.location.camp_site_identifier.present? || camp.location.name.present?) %>
            <%= admin_associated_record_label(
                  camp.location,
                  record_type_name: "location",
                  text: camp.location.camp_site_identifier.presence || camp.location.name,
                  path: admin_location_path(camp.location)
                ) %>
          <% end %>
        </td>
        <td>
          <%= link_to 'Edit', edit_admin_camp_path(camp), class: 'btn btn-xs btn-outline-primary' %>
          <%= link_to 'Show', admin_camp_path(camp), class: 'btn btn-xs btn-outline-info' %>

          <% if camp.associated_events? %>
            <span class="btn btn-xs btn-outline-secondary disabled ml-1" title="Cannot delete: camp has associated events as a location or host.">Destroy</span>
          <% else %>
             <%= link_to 'Destroy', admin_camp_path(camp), method: :delete,
                        data: { confirm: 'Are you sure?' },
                        class: 'btn btn-xs btn-outline-danger ml-1' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
